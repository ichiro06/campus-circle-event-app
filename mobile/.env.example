# This value is bundled into the app and is not a secret.
# iOS Simulator can reach the host through 127.0.0.1.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# For the standard Android Emulator, copy this file to .env.local and use:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
# A physical device needs the Mac's reachable LAN address instead.
